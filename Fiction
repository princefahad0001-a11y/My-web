// Replace this demo catalog with products from your backend.
// Prices are stored as integer cents to avoid rounding errors.
const products = [
{ id: 1, name: "Studio Wireless Headphones", category: "Electronics", price: 4990, old: 6990, emoji: "", color: "#f1eafa" },
{ id: 2, name: "Everyday Classic Sneakers", category: "Fashion", price: 3990, old: 5590, emoji: "", color: "#eaf1fc" },
{ id: 3, name: "Minimal Ceramic Mug", category: "Home & Living", price: 1290, old: 1890, emoji: "", color: "#f7ede3" },
{ id: 4, name: "Urban Essentials Backpack", category: "Fashion", price: 3490, old: 4990, emoji: "", color: "#fceae7" },
{ id: 5, name: "Move Smart Watch", category: "Electronics", price: 5990, old: 7990, emoji: "", color: "#e8eff0" },
{ id: 6, name: "Botanical Glow Serum", category: "Beauty", price: 1890, old: 2490, emoji: "", color: "#f5ebf0" },
{ id: 7, name: "Cozy Accent Cushion", category: "Home & Living", price: 2290, old: 2990, emoji: "", color: "#eaf1e7" },
{ id: 8, name: "Weekend Sunglasses", category: "Fashion", price: 1590, old: 2290, emoji: "", color: "#fff0d9" }
];

const categories = ["All", "Electronics", "Fashion", "Home & Living", "Beauty"];
const storageKey = "fiction-cart-v1";
const money = cents => new Intl.NumberFormat("en-US", {
style: "currency", currency: "USD"
}).format(cents / 100);
const byId = id => products.find(product => product.id === id);

let category = "All";
let cart = {};
let toastTimer;

// Validate persisted data before using it.
try {
const saved = JSON.parse(localStorage.getItem(storageKey) || "{}");
if (saved && typeof saved === "object" && !Array.isArray(saved)) {
for (const product of products) {
const quantity = saved[product.id];
if (Number.isInteger(quantity) && quantity > 0) {
cart[product.id] = Math.min(quantity, 99);
}
}
}
} catch {
cart = {};
}

function persistCart() {
try {
localStorage.setItem(storageKey, JSON.stringify(cart));
} catch {
// Cart continues working in memory if browser storage is unavailable.
}
}

function showToast(message) {
const toast = document.getElementById("toast");
clearTimeout(toastTimer);
toast.textContent = message;
toast.hidden = false;
toastTimer = setTimeout(() => { toast.hidden = true; }, 2400);
}

function renderCategories() {
for (const target of ["navigation", "categoryChips"]) {
const container = document.getElementById(target);
container.replaceChildren();

for (const name of categories) {
const button = document.createElement("button");
button.type = "button";
button.textContent = name === "All" && target === "navigation" ? "All categories" : name;
button.className = `${target === "categoryChips" ? "chip " : ""}${category === name ? "active" : ""}`;
button.setAttribute("aria-pressed", String(category === name));
button.addEventListener("click", () => {
category = name;
renderCategories();
renderProducts();
});
container.append(button);
}
}
}

function renderProducts() {
const query = document.getElementById("searchInput").value.trim().toLowerCase();
const sort = document.getElementById("sort").value;

const filtered = products.filter(product =>
(category === "All" || product.category === category) &&
`${product.name} ${product.category}`.toLowerCase().includes(query)
);

if (sort === "price-low") filtered.sort((a, b) => a.price - b.price);
if (sort === "price-high") filtered.sort((a, b) => b.price - a.price);
if (sort === "name") filtered.sort((a, b) => a.name.localeCompare(b.name));

document.getElementById("resultCount").textContent =
`${filtered.length} ${filtered.length === 1 ? "product" : "products"} to explore`;

// HTML uses only the trusted, static catalog abovenot user input.
document.getElementById("products").innerHTML = filtered.length
? filtered.map(product => `
<article class="product">
<div class="product-image" style="background:${product.color}">
<span class="discount">${Math.round((1 - product.price / product.old) * 100)}% OFF</span>
<span role="img" aria-label="${product.name} illustration">${product.emoji}</span>
</div>
<div class="product-body">
<span class="category-label">${product.category}</span>
<h3>${product.name}</h3>
<div class="product-bottom">
<div>
<span class="price">${money(product.price)}</span>
<del class="old-price">${money(product.old)}</del>
</div>
<button class="add" data-add="${product.id}"
aria-label="Add ${product.name} to bag">+</button>
</div>
</div>
</article>
`).join("")
: '<p class="empty">No matches yet. Try another search or category.</p>';
}

function renderCart() {
const entries = Object.entries(cart);
let total = 0;
let count = 0;

document.getElementById("cartItems").innerHTML = entries.length
? entries.map(([id, quantity]) => {
const product = byId(Number(id));
total += product.price * quantity;
count += quantity;

return `
<div class="cart-item">
<div class="cart-emoji" aria-hidden="true">${product.emoji}</div>
<div class="cart-info">
<h3>${product.name}</h3>
<p>${money(product.price * quantity)}</p>
<div class="quantity">
<button data-id="${id}" data-change="-1"
aria-label="Decrease quantity of ${product.name}"></button>
<span aria-label="Quantity ${quantity}">${quantity}</span>
<button data-id="${id}" data-change="1"
aria-label="Increase quantity of ${product.name}">+</button>
<button class="remove" data-remove="${id}"
aria-label="Remove ${product.name}">Remove</button>
</div>
</div>
</div>
`;
}).join("")
: '<p class="empty">Your bag is waiting for something good.<br>Explore the collection to get started.</p>';

document.getElementById("cartCount").textContent = count;
document.getElementById("openCart").setAttribute("aria-label", `Open shopping bag, ${count} items`);
document.getElementById("cartTotal").textContent = money(total);
document.getElementById("checkout").disabled = count === 0;
}

function updateCart(id, change) {
if (!byId(id)) return;
const next = (cart[id] || 0) + change;
if (next > 99) {
showToast("Maximum quantity is 99 per item.");
return false;
}
if (next <= 0) delete cart[id];
else cart[id] = next;

persistCart();
renderCart();
document.getElementById("checkoutMessage").textContent = "";
return true;
}

document.getElementById("products").addEventListener("click", event => {
const button = event.target.closest("[data-add]");
if (!button) return;
if (updateCart(Number(button.dataset.add), 1)) {
showToast("Added to your bag");
}
});

document.getElementById("cartItems").addEventListener("click", event => {
const button = event.target.closest("button");
if (!button) return;

const id = Number(button.dataset.remove || button.dataset.id);
const action = button.dataset.remove ? "remove" : button.dataset.change;

if (action === "remove") updateCart(id, -(cart[id] || 0));
else updateCart(id, Number(action));

// Restore keyboard focus after the cart's contents are redrawn.
const selector = action === "remove"
? "[data-change]"
: `[data-id="${id}"][data-change="${action}"]`;
const nextFocus = document.getElementById("cartItems").querySelector(selector);
(nextFocus || document.getElementById("closeCart")).focus();
});

const dialog = document.getElementById("cartDialog");
document.getElementById("openCart").addEventListener("click", () => dialog.showModal());
document.getElementById("closeCart").addEventListener("click", () => dialog.close());
dialog.addEventListener("click", event => {
if (event.target !== dialog) return;
const bounds = dialog.getBoundingClientRect();
if (event.clientX < bounds.left || event.clientX > bounds.right ||
event.clientY < bounds.top || event.clientY > bounds.bottom) {
dialog.close();
}
});

document.getElementById("searchInput").addEventListener("input", renderProducts);
document.getElementById("searchForm").addEventListener("submit", event => {
event.preventDefault();
renderProducts();
document.getElementById("shop").scrollIntoView();
});
document.getElementById("sort").addEventListener("change", renderProducts);

document.getElementById("checkout").addEventListener("click", () => {
document.getElementById("checkoutMessage").textContent =
"This is a storefront demo. Connect a secure checkout and order-management backend to accept real orders.";
});

document.getElementById("year").textContent = new Date().getFullYear();
renderCategories();
renderProducts();
renderCart();
